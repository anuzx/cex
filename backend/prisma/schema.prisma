// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  username String @unique
  password String

  orders Order[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("users")
}

model Stock {
  id     String @id @default(uuid())
  title  String
  symbol String @unique

  orders Order[]
  fills  Fill[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("stocks")
}

enum OrderType {
  LIMIT
  MARKET
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  OPEN
  FILLED
  CANCELLED
}

model Order {
  id String @id @default(uuid())

  user_id String
  user    User   @relation(fields: [user_id], references: [id])

  stock_id String
  stock    Stock  @relation(fields: [stock_id], references: [id])

  side   OrderSide
  type   OrderType
  status OrderStatus @default(OPEN)

  price Decimal @db.Decimal(18, 8)

  quantity        Int
  filled_quantity Int @default(0)

  buy_fills  Fill[] @relation("buy_order_fill")
  sell_fills Fill[] @relation("sell_order_fill")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([stock_id])
  @@index([user_id])
  @@index([side])
  @@index([status])
  @@map("orders")
}

model Fill {
  id String @id @default(uuid())

  stock_id String
  stock    Stock  @relation(fields: [stock_id], references: [id])

  price Decimal @db.Decimal(18, 8)

  quantity Int

  buy_order_id  String
  sell_order_id String

  buy_order Order @relation("buy_order_fill", fields: [buy_order_id], references: [id])

  sell_order Order @relation("sell_order_fill", fields: [sell_order_id], references: [id])

  created_at DateTime @default(now())

  @@index([stock_id])
  @@index([buy_order_id])
  @@index([sell_order_id])
  @@map("fills")
}
